#include "Version.xcconfig"
#include "Sparkle.xcconfig"

// Ad-hoc signing by default so a fresh clone builds with no Apple account.
// `task signing:setup` writes the gitignored Signing.xcconfig with your team.
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
#include? "Signing.xcconfig"

SPARKLE_FEED_URL = https:/$()/idestis.github.io/trayfinder/appcast.xml
